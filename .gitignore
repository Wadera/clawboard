# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables — real env files must never be tracked; only the
# .example templates belong in git (.env.dev leaked a real DB password into
# history once — see convergence-20260723).
.env
.env.dev
.env.local
.env.*.local
.env.backup*
.env.bak*

# Build outputs
dist/
build/
*.tsbuildinfo

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker
*.log

# Database
*.db
*.sqlite
postgres_data_*/

# Temporary files
tmp/
temp/

# Config files (use .example as template)
clawboard.config.json
# clawboard.plugins.json is deliberately TRACKED (convergence-20260723): the
# prod compose reads it from /deployed-repo, which under the exact-main wrapper
# only contains git-tracked files. No secrets; per-env tweaks go in
# config_override.
data/device-identity.json
backend/data/device/
