# ClawBoard Environment Configuration
# Copy this file to .env and fill in your values.
# Do NOT commit the real .env file — only this template belongs in version control.

# =====================================================
# DATABASE
# =====================================================
# PostgreSQL database name
POSTGRES_DB=clawboard

# PostgreSQL username
POSTGRES_USER=clawboard

# PostgreSQL password — change this to a strong random password
# Generate: openssl rand -hex 32
POSTGRES_PASSWORD=change-this-to-a-strong-password

# Database host (use the Docker service name when running in Docker)
DB_HOST=clawboard-db

# Database port (standard PostgreSQL port)
DB_PORT=5432

# =====================================================
# AUTHENTICATION
# =====================================================
# JWT secret for signing session tokens — must be long and random
# Generate: openssl rand -hex 64
JWT_SECRET=change-this-to-a-random-64-char-hex-string

# Dashboard login password hash (bcrypt)
# Generate with: node scripts/hash-password.js yourpassword
# Or: npx bcryptjs-cli hash yourpassword
# Format looks like: $2b$10$...
DASHBOARD_PASSWORD_HASH=change-this-to-a-bcrypt-hash

# =====================================================
# OPENCLAW INTEGRATION
# =====================================================
# Path to your OpenClaw identity/config directory on the host machine.
# This directory contains openclaw.json, device identity, and agent sessions.
# Mounted read-only into the container.
OPENCLAW_DIR=~/.openclaw

# Path to the bot's workspace directory on the host machine.
# This is where SOUL.md, HEARTBEAT.md, memory/, and media/ live.
# Mounted read-only into the container (except memory/ which is rw).
OPENCLAW_WORKSPACE=~/clawd

# OpenClaw Gateway WebSocket URL.
# Inside Docker: "host.docker.internal" resolves to the host machine.
# Default OpenClaw gateway port is 18789.
# If running outside Docker: ws://localhost:18789
OPENCLAW_GATEWAY_URL=ws://host.docker.internal:18789

# =====================================================
# SERVER
# =====================================================
# Backend API port (internal)
PORT=3001

# Frontend port exposed to the host
FRONTEND_PORT=8080

# Node environment
NODE_ENV=production

# CORS origin — must match the URL you use to access the frontend
CORS_ORIGIN=http://localhost:8080

# =====================================================
# FRONTEND BUILD
# =====================================================
# Public API URL used by the browser to reach the backend
# For a reverse-proxy setup this is typically the same as your dashboard URL
VITE_API_URL=http://localhost:3001

# Public WebSocket URL used by the browser for real-time updates
VITE_WS_URL=ws://localhost:3001

# =====================================================
# DATA & STORAGE
# =====================================================
# Data directory for ClawBoard's own persistent data (tasks DB, uploads, etc.)
DATA_DIR=./data

# Optional: directory for database backups
BACKUP_DIR=./backups

# =====================================================
# DEPLOYMENT
# =====================================================
# Your domain name (used by reverse proxies like Traefik/nginx)
DOMAIN=localhost

# =====================================================
# NFS / EXTERNAL STORAGE (optional)
# =====================================================
# Host path to NFS-mounted projects directory.
# Mounted read-only at /nfs-projects inside the container.
# Leave unset if you don't use NFS project storage.
NFS_PROJECTS_DIR=/mnt/nfs/projects

# =====================================================
# ADVANCED
# =====================================================
# Number of database backups to keep
KEEP_BACKUPS=7

# Database container name (used by backup/restore scripts)
DB_CONTAINER_NAME=clawboard-db
