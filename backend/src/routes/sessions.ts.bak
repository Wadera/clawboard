import express, { Request, Response, Router } from 'express';
import { pool } from '../db/connection';
import { readFile } from 'fs/promises';
import path from 'path';

// RetentionService + BackfillService DISABLED — session_messages table dropped in migration 033.
// These will be removed entirely in Phase 4 (clean API).

const router: Router = express.Router();

const SESSIONS_DIR = '/home/clawd/.openclaw/agents/main/sessions';

/**
 * GET /sessions
 * List sessions with pagination, filters, sorting.
 * Updated for migration 033 schema (session_key PK, no id/backfilled/messages_purged columns).
 */
router.get('/', async (req: Request, res: Response): Promise<any> => {
  try {
    const {
      page = '1',
      limit = '20',
      status,
      kind,
      model,
      dateFrom,
      dateTo,
      search,
      sortBy = 'last_activity_at',
      sortOrder = 'DESC'
    } = req.query;

    const offset = (parseInt(page as string) - 1) * parseInt(limit as string);
    const limitNum = parseInt(limit as string);

    const conditions: string[] = [];
    const params: any[] = [];
    let paramIndex = 1;

    if (status) {
      conditions.push(`status = $${paramIndex++}`);
      params.push(status);
    }
    if (kind) {
      conditions.push(`kind = $${paramIndex++}`);
      params.push(kind);
    }
    if (model) {
      conditions.push(`model = $${paramIndex++}`);
      params.push(model);
    }
    if (dateFrom) {
      conditions.push(`started_at >= $${paramIndex++}`);
      params.push(dateFrom);
    }
    if (dateTo) {
      conditions.push(`started_at <= $${paramIndex++}`);
      params.push(dateTo);
    }
    if (search) {
      conditions.push(`(session_key ILIKE $${paramIndex} OR label ILIKE $${paramIndex})`);
      params.push(`%${search}%`);
      paramIndex++;
    }

    const whereClause = conditions.length > 0 ? `WHERE ${conditions.join(' AND ')}` : '';

    const allowedSortFields = ['last_activity_at', 'started_at', 'message_count', 'total_cost_usd'];
    const sortField = allowedSortFields.includes(sortBy as string) ? sortBy : 'last_activity_at';
    const order = sortOrder === 'ASC' ? 'ASC' : 'DESC';

    const countResult = await pool.query(
      `SELECT COUNT(*) as total FROM sessions ${whereClause}`,
      params
    );
    const total = parseInt(countResult.rows[0].total);

    const sessionsResult = await pool.query(
      `SELECT 
        session_key, session_id, label, model, kind, channel, status,
        spawn_info,
        message_count, tool_call_count,
        input_tokens, output_tokens, thinking_tokens, cache_read_tokens, total_cost_usd,
        transcript_path, file_size,
        started_at, ended_at, last_activity_at,
        created_at, updated_at
       FROM sessions
       ${whereClause}
       ORDER BY ${sortField} ${order}
       LIMIT $${paramIndex} OFFSET $${paramIndex + 1}`,
      [...params, limitNum, offset]
    );

    res.json({
      success: true,
      sessions: sessionsResult.rows,
      pagination: {
        page: parseInt(page as string),
        limit: limitNum,
        total,
        totalPages: Math.ceil(total / limitNum)
      }
    });
  } catch (error) {
    console.error('Error fetching sessions:', error);
    res.status(500).json({
      success: false,
      error: error instanceof Error ? error.message : 'Unknown error'
    });
  }
});

/**
 * GET /sessions/stats
 * Aggregate stats across all sessions (updated for migration 033 schema).
 */
router.get('/stats', async (_req: Request, res: Response): Promise<any> => {
  try {
    const overallResult = await pool.query(`
      SELECT 
        COUNT(*) as total_sessions,
        COUNT(*) FILTER (WHERE status = 'active') as active_sessions,
        SUM(message_count) as total_messages,
        SUM(tool_call_count) as total_tool_calls,
        SUM(input_tokens) as total_input_tokens,
        SUM(output_tokens) as total_output_tokens,
        SUM(thinking_tokens) as total_thinking_tokens,
        SUM(total_cost_usd) as total_cost,
        MIN(started_at) as oldest_session,
        MAX(last_activity_at) as newest_session
      FROM sessions
    `);

    const byModelResult = await pool.query(`
      SELECT 
        model,
        COUNT(*) as session_count,
        SUM(message_count) as messages,
        SUM(total_cost_usd) as cost,
        SUM(input_tokens + output_tokens + thinking_tokens) as total_tokens
      FROM sessions
      WHERE model IS NOT NULL
      GROUP BY model
      ORDER BY session_count DESC
    `);

    const byKindResult = await pool.query(`
      SELECT kind, COUNT(*) as count, SUM(total_cost_usd) as cost
      FROM sessions GROUP BY kind
    `);

    const byStatusResult = await pool.query(`
      SELECT status, COUNT(*) as count
      FROM sessions GROUP BY status
    `);

    res.json({
      success: true,
      overall: overallResult.rows[0],
      byModel: byModelResult.rows,
      byKind: byKindResult.rows,
      byStatus: byStatusResult.rows,
    });
  } catch (error) {
    console.error('Error fetching session stats:', error);
    res.status(500).json({
      success: false,
      error: error instanceof Error ? error.message : 'Unknown error'
    });
  }
});

/**
 * GET /sessions/:key
 * Get session details by session_key or session_id UUID.
 */
router.get('/:key', async (req: Request, res: Response): Promise<any> => {
  try {
    const { key } = req.params;

    // Try session_key first, then session_id UUID
    let sessionResult = await pool.query(
      'SELECT * FROM sessions WHERE session_key = $1',
      [key]
    );
    if (sessionResult.rows.length === 0) {
      sessionResult = await pool.query(
        'SELECT * FROM sessions WHERE session_id::text = $1',
        [key]
      );
    }

    if (sessionResult.rows.length === 0) {
      return res.status(404).json({ success: false, error: 'Session not found' });
    }

    const session = sessionResult.rows[0];

    // Read transcript snippet (first + last N messages)
    const { firstMessages = '5', lastMessages = '5' } = req.query;
    const sessionId = session.session_id;
    const transcriptPath = path.join(SESSIONS_DIR, `${sessionId}.jsonl`);

    try {
      const content = await readFile(transcriptPath, 'utf-8');
      const lines = content.trim().split('\n').filter(line => line.trim());
      const messages = lines.map(line => { try { return JSON.parse(line); } catch { return null; } }).filter(Boolean);

      const firstN = parseInt(firstMessages as string);
      const lastN = parseInt(lastMessages as string);

      res.json({
        success: true,
        session,
        transcript: { totalMessages: messages.length, first: messages.slice(0, firstN), last: messages.slice(-lastN) }
      });
    } catch {
      res.json({ success: true, session, transcript: { error: 'Transcript file not found or unreadable' } });
    }
  } catch (error) {
    console.error('Error fetching session:', error);
    res.status(500).json({ success: false, error: error instanceof Error ? error.message : 'Unknown error' });
  }
});

/**
 * GET /sessions/:key/transcript
 * Stream full JSONL transcript.
 */
router.get('/:key/transcript', async (req: Request, res: Response): Promise<any> => {
  try {
    const { key } = req.params;

    let sessionResult = await pool.query(
      'SELECT session_id FROM sessions WHERE session_key = $1',
      [key]
    );
    if (sessionResult.rows.length === 0) {
      sessionResult = await pool.query(
        'SELECT session_id FROM sessions WHERE session_id::text = $1',
        [key]
      );
    }
    if (sessionResult.rows.length === 0) {
      return res.status(404).json({ success: false, error: 'Session not found' });
    }

    const sessionId = sessionResult.rows[0].session_id;
    const transcriptPath = path.join(SESSIONS_DIR, `${sessionId}.jsonl`);

    res.setHeader('Content-Type', 'application/x-ndjson');
    res.setHeader('Content-Disposition', `attachment; filename="${sessionId}.jsonl"`);

    const content = await readFile(transcriptPath, 'utf-8');
    res.send(content);
  } catch (error) {
    console.error('Error streaming transcript:', error);
    res.status(500).json({ success: false, error: error instanceof Error ? error.message : 'Unknown error' });
  }
});

export default router;
