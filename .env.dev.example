# ClawBoard Development Environment Configuration
# Copy this file to .env.dev and fill in your values.
# Used with: docker-compose -f docker-compose.dev.yml --env-file .env.dev up
# Do NOT commit .env.dev — only this template belongs in version control.

# =====================================================
# CLAWBOARD CONFIG
# =====================================================
# Path to the ClawBoard config file (relative to repo root)
CLAWBOARD_CONFIG=./clawboard.config.json

# =====================================================
# DATABASE (Development)
# =====================================================
# Uses separate dev database to keep dev and prod isolated
POSTGRES_DB=clawboard_dev
POSTGRES_USER=clawboard_dev

# Development database password — does not need to be strong, but change from default
POSTGRES_PASSWORD=dev_password_change_me

# Database host (Docker service name for dev compose)
DB_HOST=clawboard-db-dev
DB_PORT=5432

# =====================================================
# AUTHENTICATION (Development)
# =====================================================
# Dev JWT secret — change from this default
JWT_SECRET=dev-secret-change-me

# Dev dashboard login password (plain text for dev convenience)
# This is converted to a hash automatically in dev mode when LOGIN_PASSWORD is set
LOGIN_PASSWORD=devpassword

# =====================================================
# OPENCLAW INTEGRATION
# =====================================================
# Path to your OpenClaw identity/config directory on the host machine.
# Mounted into the container so the backend can read sessions and config.
OPENCLAW_DIR=~/.openclaw

# Path to the bot's workspace directory on the host machine.
# Where SOUL.md, HEARTBEAT.md, memory/, and projects/ live.
OPENCLAW_WORKSPACE=~/clawd

# OpenClaw Gateway WebSocket URL (host machine gateway)
# Default OpenClaw gateway port is 18789
OPENCLAW_GATEWAY_URL=ws://localhost:18789

# OpenClaw API HTTP URL
OPENCLAW_API_URL=http://localhost:18789

# =====================================================
# DATA
# =====================================================
# Data directory (mounted into container)
DATA_DIR=./data

# =====================================================
# SERVER
# =====================================================
# Backend API port
PORT=3006

# CORS origin (frontend dev server URL)
CORS_ORIGIN=http://localhost:3007

# Node environment
NODE_ENV=development

# =====================================================
# NFS / EXTERNAL STORAGE (optional)
# =====================================================
# Host path to NFS-mounted projects directory.
# Leave unset or as a placeholder if not using NFS.
NFS_PROJECTS_DIR=/mnt/nfs/projects
