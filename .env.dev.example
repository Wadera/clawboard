# ClawBoard dev environment template. Copy to .env.dev and fill in real
# values — .env.dev itself is gitignored and MUST never be committed.
#
# The dev compose (docker-compose.dev.yml) reads at minimum:
#   DB_PASSWORD                        — dev Postgres password
#   CLAWBOARD_JOURNAL_PUBLISH_API_KEY  — journal publish key (if used)
#   DASHBOARD_PASSWORD_HASH            — bcrypt hash of the dashboard login;
#                                        escape every $ as $$ for Compose.
# (LOGIN_PASSWORD is NOT used by the dev stack.)

# ClawBoard Configuration
CLAWBOARD_CONFIG=./clawboard.config.json

# Database Configuration (Development)
POSTGRES_DB=clawboard_dev
POSTGRES_USER=clawboard_dev
DB_PASSWORD=dev_password_change_me
DB_HOST=clawboard-db-dev
DB_PORT=5432

# Auth
JWT_SECRET=dev-secret-change-me
DASHBOARD_PASSWORD_HASH=$$2b$$12$$replace_with_bcrypt_hash

# OpenClaw
OPENCLAW_DIR=/home/user/.openclaw
OPENCLAW_GATEWAY_URL=ws://localhost:3120
OPENCLAW_API_URL=http://localhost:3120

# Data
DATA_DIR=/data
SESSIONS_DIR=/home/user/.openclaw/agents/main/sessions

# Server
PORT=3001
CORS_ORIGIN=http://localhost:8082
NODE_ENV=development
