def cmd_review(args):
    """Show review state or run the structured independent reviewer."""
    task_id = resolve_task_id(args.id)

    if getattr(args, "run_reviewer", False):
        if is_agent_context():
            print("❌ Implementation agents cannot run the independent reviewer.", file=sys.stderr)
            sys.exit(1)
        result = api("POST", f"/tasks/reviewer/{task_id}/run", {
            "dryRun": bool(getattr(args, "dry_run", False)),
            "triggeredBy": "user",
        })
        outcome = result.get("outcome", {})
        decision = outcome.get("decision", "unknown")
        prefix = "🔎 DRY RUN" if getattr(args, "dry_run", False) else "✅ REVIEWER"
        print(f"{prefix}: {decision}")
        if outcome.get("summary"):
            print(f"   {outcome['summary']}")
        for finding in outcome.get("findings", []):
            print(f"   - {finding.get('severity', 'info')}: {finding.get('message', '')}")
        return

    result = api("GET", f"/tasks/{task_id}")
    task = result.get("task", result)
    
    subtasks = task.get("subtasks") or []
    title = task.get("title", "Unknown")
    status = task.get("status", "unknown")
    
    # Agent auto-move: if this is an implementation agent and task is in-progress, move to review.
    # QA/reviewer workers must not trigger implementation handoff behavior just because they are automated.
    is_agent = is_agent_context()
    if is_agent and status == "in-progress":
        try:
            move_result = api("PATCH", f"/tasks/{task_id}", {"status": "review", "role": "agent"})
            moved = move_result.get("task", {})
            if moved.get("status") == "review":
                status = "review"
                print(f"✅ Moved task to review", file=sys.stderr)
            else:
                print(f"⚠️  Failed to move task to review", file=sys.stderr)
        except Exception as e:
            print(f"⚠️  Could not move task to review: {e}", file=sys.stderr)
    
    # Count subtasks by status (6-state)
    completed = sum(1 for s in subtasks if s.get("status") == "completed")
    skipped = sum(1 for s in subtasks if s.get("status") == "skipped")
    review = sum(1 for s in subtasks if s.get("status") in ("review", "in_review"))
    in_progress = sum(1 for s in subtasks if s.get("status") == "in_progress")
    blocked = sum(1 for s in subtasks if s.get("status") == "blocked")
    empty = sum(1 for s in subtasks if s.get("status") in ("empty", "new"))
    total = len(subtasks)
    done = completed + skipped
    
    short_id = task_id[:8]
    
    print(f"\n📋 Review: {title} ({short_id})")
    print(f"Status: {status} | Subtasks: {done}/{total} done")
    if blocked > 0:
        print(f"⚠️ WARNING: {blocked} subtask(s) BLOCKED!")
    print()
    
    # Display subtasks with clear markers
    for i, s in enumerate(subtasks):
        s_status = s.get("status", "empty")
        # Normalize old status names
        if s_status == "new":
            s_status = "empty"
        if s_status == "in_review":
            s_status = "review"
            
        icon = format_subtask_status(s)
        text = s.get("text", "???")
        note = f" — {s.get('reviewNote')}" if s.get("reviewNote") else ""
        blocked_note = f" [{s.get('blockedReason')}]" if s.get("blockedReason") else ""
        
        marker = ""
        if s_status == "review":
            marker = "  ← NEEDS REVIEW"
        elif s_status == "blocked":
            marker = "  ← BLOCKED"
        elif s_status == "in_progress":
            marker = "  ← IN PROGRESS"
        elif s_status == "empty":
            marker = "  ← NOT STARTED"
        
        print(f"  [{i}] {icon} {s_status}: {text}{note}{blocked_note}{marker}")
    
    print()
    print("Actions:")
    
    # Show approve/reject for subtasks in review
    for i, s in enumerate(subtasks):
        if s.get("status") in ("review", "in_review"):
            print(f"  clawboard approve-subtask {short_id} {i}    # Approve → completed")
            print(f"  clawboard reject-subtask {short_id} {i}     # Reject → empty")
    
    # Show unblock for blocked subtasks
    for i, s in enumerate(subtasks):
        if s.get("status") == "blocked":
            print(f"  clawboard uncomplete-subtask {short_id} {i} # Unblock → empty")
            print(f"  clawboard skip-subtask {short_id} {i}       # Skip (counts as done)")
    
    # Show move to completed if all done
    if done == total and total > 0:
        print(f"  clawboard move {short_id} completed       # Complete (all done)")
    elif total > 0:
        remaining = total - done
        print(f"  # Cannot complete yet — {remaining} subtask(s) not done")
    
    print(f"  clawboard move {short_id} in-progress     # Send back for more work")
    print()


