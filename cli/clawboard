def _import_doctor():
    """Import the pure doctor check registry, tolerating symlinked invocation."""
    try:
        from clawboard_doctor import run_doctor, render_human, render_discord_summary
    except ImportError:
        sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
        from clawboard_doctor import run_doctor, render_human, render_discord_summary
    return run_doctor, render_human, render_discord_summary


def _fetch_doctor_payloads():
    """Read-only GETs; doctor never mutates board state."""
    tasks = api("GET", "/tasks?includeArchived=true").get("tasks", [])
    projects = api("GET", "/projects?includeHidden=true", exit_on_error=False).get("projects", [])
    agent_types = api("GET", "/agent-types", exit_on_error=False).get("agentTypes", [])
    model_status = api("GET", "/models/status", exit_on_error=False)
    if not isinstance(model_status, dict) or model_status.get("success") is False:
        model_status = {}
    return tasks, projects, agent_types, model_status


def _post_discord_webhook(webhook_url, content):
    body = json.dumps({"content": content[:1900]}).encode("utf-8")
    req = urllib.request.Request(webhook_url, data=body, method="POST")
    req.add_header("Content-Type", "application/json")
    with urllib.request.urlopen(req, timeout=20) as resp:
        return resp.status


def _deliver_hermes_discord(target, content):
    """Deliver a summary via the LLM-free `hermes send` CLI (as the hermes user).

    Requires NOPASSWD sudo for the invoking user (true for clawd on the AI VM).
    Returns True on delivery success.
    """
    cmd = [
        "sudo", "-n", "-u", "hermes",
        "env", "HOME=/home/hermes",
        DOCTOR_HERMES_BIN, "send", "--to", target, content,
    ]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        print(f"❌ hermes send failed to run: {e}", file=sys.stderr)
        return False
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip()
        print(f"❌ hermes send exited {proc.returncode}: {detail}", file=sys.stderr)
        return False
    return True


def _doctor_deliver_target(args):
    return (
        getattr(args, "deliver_target", None)
        or os.environ.get("CLAWBOARD_DOCTOR_DELIVER_TARGET")
        or DOCTOR_DEFAULT_HERMES_TARGET
    )


def _install_doctor_cron(args, dry_run=False):
    """Append a weekly doctor cron line to the invoking user's crontab (idempotent)."""
    script_path = os.path.realpath(__file__)
    repo_dir = os.path.dirname(os.path.dirname(script_path))
    deliver = args.deliver if args.deliver != "stdout" else "hermes-discord"
    cron_line = (
        "0 8 * * 1 "
        f"cd {repo_dir} && "
        f"python3 {script_path} doctor --json --deliver {deliver} "
        f"--deliver-target {_doctor_deliver_target(args)} "
        ">> /tmp/clawboard-doctor.log 2>&1"
    )
    if dry_run:
        print("DRY RUN: would install cron line:")
        print(cron_line)
        return True
    current = subprocess.run(["crontab", "-l"], capture_output=True, text=True, timeout=10)
    existing = current.stdout if current.returncode == 0 else ""
    lines = [line for line in existing.splitlines() if DOCTOR_CRON_MARKER not in line]
    lines.append(cron_line)
    proc = subprocess.run(["crontab", "-"], input="\n".join(lines).rstrip() + "\n",
                          capture_output=True, text=True, timeout=10)
    if proc.returncode != 0:
        print(f"❌ Failed to install cron: {proc.stderr.strip()}", file=sys.stderr)
        return False
    print("✅ Installed weekly clawboard doctor cron (Mondays 08:00).")
    print(cron_line)
    return True


def cmd_doctor(args):
    """Run ClawBoard board-integrity checks (read-only against the API)."""
    run_doctor, render_human, render_discord_summary = _import_doctor()

    if getattr(args, "install_cron", False):
        if not _install_doctor_cron(args, dry_run=getattr(args, "dry_run", False)):
            sys.exit(1)
        return

    tasks, projects, agent_types, model_status = _fetch_doctor_payloads()
    result = run_doctor(tasks, projects, agent_types, model_status)

    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    elif args.discord_summary:
        print(render_discord_summary(result))
    else:
        print(render_human(result))

    delivery_failed = False
    summary_text = render_discord_summary(result)

    # Delivery via hermes send (no webhook secret needed; default is stdout only)
    if args.deliver == "hermes-discord":
        target = _doctor_deliver_target(args)
        if args.dry_run:
            print(f"DRY RUN: would deliver via hermes send --to {target}:")
            print(summary_text)
        elif _deliver_hermes_discord(target, summary_text):
            print(f"📣 Doctor summary delivered via hermes to {target}")
        else:
            delivery_failed = True

    # Optional direct Discord webhook delivery (requires webhook URL)
    webhook = args.discord_webhook or os.environ.get("CLAWBOARD_DOCTOR_DISCORD_WEBHOOK") \
        or os.environ.get("CLAWBOARD_DOCTOR_DISCORD_WEBHOOK_URL")
    if args.post_discord or (webhook and args.discord_webhook):
        if not webhook:
            print("❌ Set --discord-webhook or CLAWBOARD_DOCTOR_DISCORD_WEBHOOK_URL to post Discord summaries.", file=sys.stderr)
            sys.exit(1)
        if args.dry_run:
            print("DRY RUN: would post Discord summary via webhook:")
            print(summary_text)
        else:
            try:
                status = _post_discord_webhook(webhook, summary_text)
                print(f"📣 Discord summary posted (HTTP {status})")
            except (urllib.error.URLError, OSError) as e:
                print(f"❌ Discord webhook post failed: {e}", file=sys.stderr)
                delivery_failed = True

    if delivery_failed:
        sys.exit(1)
    if result["summary"].get("severityCounts", {}).get("error", 0):
        sys.exit(2)

def cmd_complete_subtask(args):
    """Agent marks subtask as 'review' (NOT completed).
    
    In the 6-state lifecycle, agents mark work as ready for review.
    The orchestrator then approves (completed) or rejects (empty).
    """
    task_id = resolve_task_id(args.task_id)
    index = int(args.index)
    
    # Agents mark as 'review' when done with their work
    result = api("PATCH", f"/tasks/{task_id}/subtasks/{index}/status", {
        "status": "review",
        "role": "agent"
    })
    
    task = result.get("task", {})
    subtasks = task.get("subtasks") or []
    
    if index < len(subtasks):
        print(f"🟡 Marked subtask [{index}] as review: {subtasks[index].get('text', '')}")
    else:
        print(f"🟡 Marked subtask [{index}] as review")
    
    summary = result.get("subtaskSummary", {})
    print(f"   Summary: {summary.get('completed', 0)} ✅ | {summary.get('review', 0)} 🟡 | {summary.get('in_progress', 0)} 🔄 | {summary.get('empty', 0)} ⬜")
    if summary.get('blocked', 0) > 0:
        print(f"   ⚠️ {summary.get('blocked', 0)} subtask(s) blocked!")
    print(format_task(task, verbose=True))

