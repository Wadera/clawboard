        print(f"   Status: {project.get('status', 'unknown')}")
        print(f"\n📋 Will affect:")
        print(f"   • {len(tasks)} tasks")
        print(f"   • {len(links)} links")
        
        if tasks:
            print(f"\n   Tasks to be deleted:")
            for task in tasks[:5]:  # Show first 5
