def cmd_spawn(args):
    task_id = resolve_task_id(args.id)
    dry_run = getattr(args, 'dry_run', False)
    model_override = getattr(args, 'model', None)
    thinking_override = getattr(args, 'thinking', None)
    run_mode = getattr(args, 'run', False)  # --run: move to in-progress + spawn
    no_attach = getattr(args, 'no_attach', False)
    attach_files = getattr(args, 'attach', None) or []
    fire_and_forget = getattr(args, 'fire_and_forget', False)
    interactive_flag = getattr(args, 'interactive', False)
    interactive = interactive_flag or not fire_and_forget  # interactive task sessions are the default

    # Warn if task has no subtasks (unless suppressed)
    force = getattr(args, 'force', False)
    task_data = api("GET", f"/tasks/{task_id}")
    task = task_data.get("task", task_data)
    subtasks = task.get("subtasks") or []
    if not force and len(subtasks) == 0:
        if not confirm_prompt("⚠️ This task has no subtasks. Agents work better with clear checkpoints. Spawn anyway? (y/N): "):
            print("Aborted.", file=sys.stderr)
            sys.exit(1)

    # --dry-run: POST /tasks/:id/spawn-prompt → prints full prompt without spawning
    if dry_run:
        result = api("POST", f"/tasks/{task_id}/spawn-prompt")
        prompt = result.get("prompt", "")
        print("─── Agent Spawn Prompt (dry-run) ───")
        print(prompt)
        print("────────────────────────────────────")
        if attach_files:
            print(f"\nNote: --attach flags provided ({len(attach_files)} file(s)) — would be sent with real spawn")
        if no_attach:
            print("\nNote: --no-attach flag set — auto-collection disabled for real spawn")
        return

    # ── Step 1 (--run): Move task to in-progress ──────────────────────────────
    if run_mode:
        current_status = task.get("status", "")
        if current_status == "in-progress":
            print(f"ℹ️  Task already in-progress", file=sys.stderr)
        else:
            print(f"📋 [1/2] Moving task to in-progress (was: {current_status})...", file=sys.stderr)
            try:
                move_result = api("PATCH", f"/tasks/{task_id}", {
                    "status": "in-progress",
                    "notes": f"Auto-moved by clawboard spawn --run at {datetime.utcnow().isoformat()}Z"
                })
                moved_task = move_result.get("task", {})
                if moved_task.get("status") == "in-progress":
                    print(f"   ✅ Moved to in-progress", file=sys.stderr)
                else:
                    print(f"   ⚠️  Move may not have succeeded: status={moved_task.get('status')}", file=sys.stderr)
            except Exception as e:
                print(f"❌ Step 1 failed (move to in-progress): {e}", file=sys.stderr)
                sys.exit(1)

    capability_tags = set(t for t in (task.get("tags") or []) if t in {
        "browser", "host-browser", "elevated", "network", "discord-thread", "long-running"
    })
    if not interactive and ({"host-browser", "discord-thread"} & capability_tags):
        print("❌ This task requires interactive mode because it is tagged with host-browser or discord-thread.", file=sys.stderr)
        sys.exit(1)

    # Determine model: CLI flag > task field > backend configured default
    task_model = task.get("model")
    model = model_override or task_model

    # ── Build spawn payload ────────────────────────────────────────────────────
    spawn_payload = {}
    if model:
        spawn_payload["model"] = model
    if thinking_override:
        spawn_payload["thinking"] = thinking_override
    if getattr(args, 'execution_mode', None):
        spawn_payload["executionMode"] = args.execution_mode
    if getattr(args, 'execution_harness', None):
        spawn_payload["harness"] = args.execution_harness
    if getattr(args, 'access_profile', None):
        spawn_payload["accessProfile"] = args.access_profile
    if getattr(args, 'required_capabilities', None) is not None:
        spawn_payload["requiredCapabilities"] = [c.strip() for c in args.required_capabilities.split(',') if c.strip()]

    # Handle --agent-type override for spawn
    agent_type_override = getattr(args, 'agent_type', None)
    if agent_type_override:
        at_resp = api("GET", f"/agent-types/{agent_type_override}")
        if at_resp.get("success") and at_resp.get("agentType"):
            spawn_payload["agentTypeId"] = at_resp["agentType"]["id"]
            print(f"🎭 Agent persona: {at_resp['agentType']['name']}", file=sys.stderr)
        else:
            print(f"⚠️  Agent type '{agent_type_override}' not found — spawning without persona override", file=sys.stderr)

    if interactive:
        spawn_payload["interactive"] = True
        if interactive_flag:
            print(f"🔗 Interactive mode: will spawn a steerable task session", file=sys.stderr)
        else:
            print(f"🔗 Default mode: spawning an interactive task session", file=sys.stderr)
    else:
        print(f"⚙️ Legacy mode: spawning fire-and-forget cron job", file=sys.stderr)

    # Handle --no-attach flag
    if no_attach:
        spawn_payload["noAttach"] = True
        print(f"📎 Attachment auto-collection disabled (--no-attach)", file=sys.stderr)

    # Handle explicit --attach <file> flags
    if attach_files and not no_attach:
        attachments = []
        total_bytes = 0
        MAX_TOTAL = 500 * 1024  # 500 KB CLI-side budget
        for fpath in attach_files:
            att = _read_file_as_attachment(fpath)
            if att is None:
                continue
            att_bytes = len(att['content'].encode('utf-8')) if att['encoding'] == 'utf8' else len(att['content']) * 3 // 4
            if total_bytes + att_bytes > MAX_TOTAL:
                print(f"⚠️  --attach: budget exceeded, skipping remaining files (total > {MAX_TOTAL // 1024} KB)", file=sys.stderr)
                break
            attachments.append(att)
            total_bytes += att_bytes
            print(f"📎 Attaching: {att['name']} ({att_bytes // 1024} KB)", file=sys.stderr)
        if attachments:
            spawn_payload["attachments"] = attachments
            print(f"   → {len(attachments)} file(s), {total_bytes // 1024} KB total", file=sys.stderr)

    # ── Step 2 (--run): Spawn agent — backend builds prompt ───────────────────
    # All prompt building (project context, subtasks, deps) happens server-side
    # in promptTemplate.ts. CLI only sends model and thinking overrides.
    print(f"🚀 {'[2/2] ' if run_mode else ''}Spawning agent for task {task_id}...", file=sys.stderr)

    try:
        spawn_result = api("POST", f"/tasks/{task_id}/spawn-agent", spawn_payload, timeout=120)
    except Exception as e:
        print(f"❌ Failed to spawn agent: {e}", file=sys.stderr)
        sys.exit(1)

    if not spawn_result.get("success"):
        print(f"❌ spawn-agent failed: {spawn_result.get('error', 'Unknown error')}", file=sys.stderr)
        sys.exit(1)

    child_session_key = spawn_result.get("childSessionKey")
    run_id = spawn_result.get("runId")
    acp_session_key = spawn_result.get("acpSessionKey")

    if not child_session_key:
        print(f"❌ No childSessionKey in response: {spawn_result}", file=sys.stderr)
        sys.exit(1)

    # Task activeAgent is already updated by the backend endpoint
    # Print confirmation
    base_url = get_api_url().rstrip("/")
    # Derive dashboard URL from API base (strip :3001 port and /api suffix)
    dashboard_base = base_url.replace("/api", "").replace(":3001", "").rstrip("/")
    # Use known production dashboard if it looks like localhost
    if "localhost" in dashboard_base or "127.0.0.1" in dashboard_base:
        dashboard_url = f"https://your-dashboard.example.com/dashboard/tasks?focus={task_id}"
    else:
        dashboard_url = f"{dashboard_base}/dashboard/tasks?focus={task_id}"

    harness = spawn_result.get("harness", "openclaw")
    spawn_metadata = spawn_result.get("metadata") or {}
    provisional = bool(spawn_result.get("provisional")) or child_session_key == "pending"
    if provisional:
        # Agent launched, but Hermes registers its session id only once the first
        # turn starts — ClawBoard links it automatically in the background.
        print(f"✅ {harness} agent launched for task {task_id} (session id pending)")
        if run_id:
            print(f"   PID:        {run_id}")
        if spawn_metadata.get("logPath"):
            print(f"   Log file:   {spawn_metadata.get('logPath')}")
        if spawn_metadata.get("sourceTag"):
            print(f"   Source tag: {spawn_metadata.get('sourceTag')}")
        print(f"   ClawBoard links the session id automatically — check: clawboard session-status {task_id[:8]}")
    elif interactive or acp_session_key:
        print(f"✅ {harness} interactive session spawned for task {task_id}")
        print(f"   Session:     {child_session_key}")
        if acp_session_key:
            print(f"   Control Key: {acp_session_key}")
        print(f"   Steer with:  clawboard steer {task_id[:8]} '<message>'")
        print(f"   Cancel with: clawboard cancel {task_id[:8]}")
    else:
        print(f"✅ {harness} agent spawned for task {task_id}")
        print(f"   Session: {child_session_key}")
        if run_id:
            print(f"   Run ID:  {run_id}")
    print(f"   Dashboard: {dashboard_url}")

    # ── Log spawn action to orchestration log ─────────────────────────────────
    if run_mode:
        try:
            log_path = _write_spawn_log(
                task_id=task_id,
                task_title=task.get("title", ""),
                session_key=child_session_key,
                run_id=run_id,
                model=model,
                extra={
                    "mode": "interactive" if interactive else "fire-and-forget",
                    "project": task.get("project"),
                    "subtask_count": len(subtasks),
                    "attachments_written": spawn_result.get("attachmentsWritten", False),
                    "no_attach": no_attach,
                    "explicit_attach_count": len(attach_files),
                    "acp_session_key": acp_session_key,
                    "provisional": provisional,
                }
            )
            print(f"   Log:       {log_path}")
            if spawn_result.get("attachmentsWritten"):
                print(f"   Attachments: ✅ written to agent workspace")
        except Exception as e:
            print(f"⚠️  Could not write spawn log (non-fatal): {e}", file=sys.stderr)

