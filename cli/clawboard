# ─── Auth ───

def get_api_url():
    """Get the effective API URL (flag > env > default)."""
    if _CLI_API:
        return _CLI_API
    return API

def get_token():
    """Get a valid JWT token.
    
    Priority: --token flag > CLAWBOARD_TOKEN env > cached token file.
    If no token is available, attempts password login if CLAWBOARD_PASSWORD is set.
    """
    import time
    
    # 1. CLI flag
    if _CLI_TOKEN:
        return _CLI_TOKEN
    
    # 2. Environment variable
    env_token = os.environ.get("CLAWBOARD_TOKEN")
    if env_token:
        return env_token
    
    # 3. Cached token file (token.json — written by 'clawboard login')
    if os.path.exists(TOKEN_FILE):
        try:
            with open(TOKEN_FILE) as f:
                cached = json.load(f)
            # Check if token expires in more than 1 hour
            if cached.get("expires_at", 0) > time.time() + 3600:
                return cached["token"]
        except:
            pass
    
    # 3b. Shared config file (config.json — also used by clawbeat)
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE) as f:
                cfg = json.load(f)
            token = cfg.get("api_token") or cfg.get("token")
            if token:
                return token
        except:
            pass
    
    # 4. Password-based login (if CLAWBOARD_PASSWORD is set)
    password = os.environ.get("CLAWBOARD_PASSWORD")
    if password:
        return _login_with_password(password)
    
    print("❌ No auth token found. Set CLAWBOARD_TOKEN, use --token, or run 'clawboard login'.", file=sys.stderr)
    sys.exit(1)

def _login_with_password(password):
    """Login with password and cache the token."""
    import time
    base = get_api_url()
    url = f"{base}/auth/login"
    body = json.dumps({"password": password}).encode()
    req = urllib.request.Request(url, data=body, method="POST")
    req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read())
            token = data["token"]
            # Cache token
            os.makedirs(os.path.dirname(TOKEN_FILE), exist_ok=True)
            with open(TOKEN_FILE, "w") as f:
                json.dump({"token": token, "expires_at": time.time() + 6*24*3600}, f)
            return token
    except urllib.error.HTTPError as e:
        print(f"❌ Auth failed: {e.code}", file=sys.stderr)
        sys.exit(1)

def _derive_dashboard_url_from_api(api_url):
    """Best-effort dashboard URL derivation from API URL."""
    if not api_url:
        return ""
    base = api_url.rstrip('/')
    if '/api/dev' in base:
        return base.replace('/api/dev', '/dashboard-dev')
    if base.endswith('/api'):
        return base[:-4] + '/dashboard'
    if '/api/' in base:
        return base.replace('/api/', '/')
    return ""


def get_dashboard_url():
    """Get dashboard base URL for generating links. Env > config.json > derived from API."""
    if DASHBOARD_URL:
        return DASHBOARD_URL.rstrip("/")
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE) as f:
                cfg = json.load(f)
            url = cfg.get("dashboard_url", "")
            if url:
                return url.rstrip("/")
        except:
            pass
    return _derive_dashboard_url_from_api(get_api_url())


def cmd_login(args):
    """Login to ClawBoard and cache the token."""
    import getpass
    password = getattr(args, 'password', None) or os.environ.get("CLAWBOARD_PASSWORD") or getpass.getpass("Password: ")
    token = _login_with_password(password)
    print(f"✅ Logged in. Token cached at {TOKEN_FILE}")
    return token

# ─── Helpers ───

def is_qa_context():
    """Check if running as an independent QA/reviewer automation worker."""
    role = os.environ.get("CLAWBOARD_ROLE", "").strip().lower()
    if os.environ.get("CLAWBOARD_QA_AGENT") == "1":
        return True
    if role in ("qa", "reviewer", "orchestrator"):
        return True
    return "--qa-agent" in sys.argv or "--reviewer-agent" in sys.argv


def is_agent_context():
    """Check if running in implementation-agent context.

    QA/reviewer workers are automated agents too, but they are intentionally
    allowed to approve/reject/block after independent verification. Treat them
    as reviewer automation, not implementation agents.
    """
    if is_qa_context():
        return False
    # Check environment variable
    if os.environ.get("CLAWBOARD_AGENT") == "1":
        return True
    # Check command-line args
    return "--agent" in sys.argv


def is_automation_context():
    """Any non-interactive automation context that should auto-confirm prompts."""
    return is_agent_context() or is_qa_context()

# Global ref set after parse_args; used by confirm_prompt
_GLOBAL_YES = False

def confirm_prompt(message):
    """Show a y/N confirmation prompt. Returns True if confirmed.
    
    Auto-confirms when:
    - --yes/-y global flag is set
    - Running in agent/QA automation context
    """
    if _GLOBAL_YES or is_automation_context():
        return True
    try:
        answer = input(message)
    except (EOFError, KeyboardInterrupt):
        print(file=sys.stderr)
        return False
    return answer.strip().lower() == "y"

def api(method, path, data=None, timeout=30, exit_on_error=True):
    """Make API request, return parsed JSON."""
    url = f"{get_api_url()}{path}"
    body = json.dumps(data).encode() if data else None
    req = urllib.request.Request(url, data=body, method=method)
    req.add_header("Content-Type", "application/json")
    req.add_header("Authorization", f"Bearer {get_token()}")
    # Tell the API which automation context this CLI invocation represents.
    # Ordinary implementation agents stay constrained; QA/reviewer workers can
    # use reviewer/orchestrator actions after independent verification.
    if is_qa_context():
        req.add_header("X-Clawboard-Role", "qa")
    elif is_agent_context():
        req.add_header("X-Clawboard-Role", "agent")
    else:
        req.add_header("X-Clawboard-Role", "orchestrator")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        body = e.read().decode()
        try:
            err = json.loads(body)
            if exit_on_error:
                print(f"❌ API error: {err.get('error', body)}", file=sys.stderr)
                sys.exit(1)
            return {"success": False, "error": err.get('error', body), "status": e.code}
        except:
            if exit_on_error:
                print(f"❌ HTTP {e.code}: {body}", file=sys.stderr)
                sys.exit(1)
            return {"success": False, "error": body, "status": e.code}

def resolve_project(name):
    """Fuzzy-match project name. Returns the canonical project name string."""
    if not name:
        return None
    projects = api("GET", "/projects?includeHidden=true").get("projects", [])
    
    # Exact match first
    for p in projects:
        if p["name"] == name:
            return p["name"]
    
    # Fuzzy match
    best = None
    best_score = 0
    for p in projects:
        score = SequenceMatcher(None, name.lower(), p["name"].lower()).ratio()
        if score > best_score:
            best_score = score
            best = p
        # Also check substring
        if name.lower() in p["name"].lower() or p["name"].lower() in name.lower():
            if score > 0.3:
                best = p
                best_score = max(score, 0.9)
    
    if best and best_score > 0.4:
        if best["name"] != name:
            print(f"📁 Matched project: \"{name}\" → \"{best['name']}\"", file=sys.stderr)
        return best["name"]
    
    print(f"⚠️  No project found matching \"{name}\". Available:", file=sys.stderr)
    for p in projects:
        print(f"   - {p['name']}", file=sys.stderr)
    sys.exit(1)

def resolve_project_id(name_or_id):
    """Resolve project name or ID to a full project ID."""
    projects = api("GET", "/projects?includeHidden=true").get("projects", [])
    
    # Try ID match first (full or prefix)
    for p in projects:
        if p["id"] == name_or_id or p["id"].startswith(name_or_id):
            return p["id"]
    
    # Try name match (exact then fuzzy)
    for p in projects:
        if p["name"] == name_or_id:
            return p["id"]
    
    # Fuzzy name match
    best = None
    best_score = 0
    for p in projects:
        score = SequenceMatcher(None, name_or_id.lower(), p["name"].lower()).ratio()
        if name_or_id.lower() in p["name"].lower() or p["name"].lower() in name_or_id.lower():
            score = max(score, 0.9)
        if score > best_score:
            best_score = score
            best = p
    
    if best and best_score > 0.4:
        if best["name"] != name_or_id and not best["id"].startswith(name_or_id):
            print(f"📁 Matched project: \"{name_or_id}\" → \"{best['name']}\"", file=sys.stderr)
        return best["id"]
    
    print(f"⚠️  No project found matching \"{name_or_id}\". Available:", file=sys.stderr)
    for p in projects:
        print(f"   - {p['name']} ({p['id'][:8]})", file=sys.stderr)
    sys.exit(1)

def validate_status(status):
    """Validate and auto-correct common status mistakes."""
    if status in VALID_STATUSES:
        return status
    # Common corrections
    corrections = {
        "idea": "ideas",
        "plan": "ideas",
        "plans": "ideas",
        "doing": "in-progress",
        "progress": "in-progress",
        "wip": "in-progress",
        "blocked": "stuck",
        "done": "completed",
        "complete": "completed",
        "archive": "archived",
    }
    if status.lower() in corrections:
        corrected = corrections[status.lower()]
        print(f"📝 Status corrected: \"{status}\" → \"{corrected}\"", file=sys.stderr)
        return corrected
    
    print(f"❌ Invalid status: \"{status}\". Valid: {', '.join(VALID_STATUSES)}", file=sys.stderr)
    sys.exit(1)

def parse_subtasks(text):
    """Parse semicolon-separated subtasks into correct API format."""
    if not text:
        return None
    items = [s.strip() for s in text.split(";") if s.strip()]
    return [{"text": item, "status": "empty"} for item in items]

def format_subtask_status(s):
    """Format subtask status with appropriate icon.
    
    6-state lifecycle:
      ⬜ empty       - Not started
      🔄 in_progress - Agent working on it
      🟡 review      - Awaiting orchestrator review
      🔴 blocked     - Cannot proceed
      ⏭️ skipped     - Intentionally skipped
      ✅ completed   - Approved
    """
    status = s.get("status", "empty")
    # Legacy support: if no status field, check completed boolean
    if status in ("new", "empty") and s.get("completed"):
        status = "completed"
    # Map old status names to new
    if status == "new":
        status = "empty"
    if status == "in_review":
        status = "review"
    
    icons = {
        "empty": "⬜",
        "in_progress": "🔄",
        "review": "🟡",
        "blocked": "🔴",
        "skipped": "⏭️",
        "completed": "✅"
    }
    return icons.get(status, "❓")

def format_task(t, verbose=False):
    """Format a task for display."""
    status_icons = {
        "ideas": "💡", "todo": "📋", "in-progress": "🔄",
        "stuck": "🚧", "review": "🔍", "completed": "✅", "archived": "📦"
    }
    priority_icons = {
        "urgent": "🔴", "high": "🟠", "normal": "🟡", "low": "🟢", "someday": "⚪"
    }
    icon = status_icons.get(t.get("status", ""), "❓")
    pri = priority_icons.get(t.get("priority", ""), "")
    proj = f" 📁{t['project']}" if t.get("project") else ""
    tags = f" 🏷️{','.join(t['tags'])}" if t.get("tags") else ""
    subtask_count = len(t.get("subtasks") or [])
    
    # Count subtasks by status (6-state)
    subtasks = t.get("subtasks") or []
    done = sum(1 for s in subtasks if s.get("status") in ("completed", "skipped") or s.get("completed"))
    in_progress = sum(1 for s in subtasks if s.get("status") == "in_progress")
    review = sum(1 for s in subtasks if s.get("status") in ("review", "in_review"))
    blocked = sum(1 for s in subtasks if s.get("status") == "blocked")
    
    if subtask_count:
        if blocked > 0:
            subs = f" [{done}/{subtask_count} ✅ {blocked} 🔴]"
        elif review > 0 or in_progress > 0:
            subs = f" [{done}/{subtask_count} ✅ {review} 🟡 {in_progress} 🔄]"
        else:
            subs = f" [{done}/{subtask_count}]"
    else:
        subs = ""
    
    thinking = f" 🧠{t['thinking']}" if t.get("thinking") else ""
    attempts = f" 🔁{t['attemptCount']}" if t.get("attemptCount", 0) > 0 else ""
    blocked_icon = " 🔒" if t.get("blocked") else ""
    
    short_id = t["id"][:8]
    line = f"{icon} {pri} {short_id}  {t['title']}{proj}{tags}{subs}{thinking}{attempts}{blocked_icon}"
    
    if verbose:
        line += f"\n   Status: {t.get('status')} | Priority: {t.get('priority')} | ID: {t['id']}"
        if t.get("description"):
            desc = t["description"][:120]
            line += f"\n   {desc}{'...' if len(t.get('description','')) > 120 else ''}"
        if t.get("notes"):
            line += f"\n   📝 Notes: {t['notes'][:100]}{'...' if len(t.get('notes','')) > 100 else ''}"
        if t.get("subtasks"):
            line += "\n   Subtasks:"
            for i, s in enumerate(t["subtasks"]):
                status_icon = format_subtask_status(s)
                status_label = s.get("status", "empty")
                note = f" — {s.get('reviewNote')}" if s.get("reviewNote") else ""
                line += f"\n     [{i}] {status_icon} {s.get('text', '???')}{note}"
        if t.get("blockedBy"):
            line += f"\n   ⛔ Blocked by: {', '.join(t['blockedBy'])}"
        if t.get("dependsOn"):
            dep_ids = [d[:8] for d in t["dependsOn"]]
            line += f"\n   🔗 Depends on: {', '.join(dep_ids)}"
        if t.get("blockingTasks"):
            blocking = [f"{b['title'][:30]} ({b['id'][:8]})" for b in t["blockingTasks"]]
            line += f"\n   🔒 Blocked by incomplete: {', '.join(blocking)}"
        if t.get("dependentTasks"):
            deps = [f"{d['title'][:30]} ({d['id'][:8]})" for d in t["dependentTasks"]]
            line += f"\n   ⬇️  Blocks: {', '.join(deps)}"
        if t.get("blocked"):
            line += f"\n   🔒 BLOCKED (dependencies not complete)"
    
    return line

def format_project(p, include_stats=False, stats=None):
    """Format a project for display."""
    status_icons = {
        "active": "🟢", "paused": "⏸️", "completed": "✅", "archived": "📦"
    }
    icon = status_icons.get(p.get("status", "active"), "⚪")
    desc = f" - {p['description'][:50]}..." if p.get("description") and len(p.get("description", "")) > 50 else (f" - {p['description']}" if p.get("description") else "")
    
    hidden = " 🔒" if p.get("is_hidden") else ""
    line = f"  {icon} {p['name']}{hidden}{desc}  (ID: {p['id'][:12]})"
    
    if include_stats and stats:
        total = stats.get("total", 0)
        completed = stats.get("completed", 0)
        in_progress = stats.get("inProgress", 0)
        line += f"\n     📊 Tasks: {total} total, {in_progress} in-progress, {completed} completed"
    
    if p.get("links"):
        line += "\n     🔗 Links:"
        for link in p["links"]:
            line += f"\n        - [{link.get('type', 'other')}] {link.get('title', 'Untitled')}: {link.get('url', '')}"
    
    return line

def create_project_skeleton(project_name):
    """Create project directory structure with local fast storage + NFS shared link.
    
    Local (fast):  PROJECT_ROOT/<name>/repo/, workspace/, docs/, .project.yaml
    NFS (shared):  NFS_ROOT/<name>/files/, data/, archives/
    Symlink:       <local>/shared/ → <nfs>/<name>/
    
    Falls back to DATA_DIR (legacy) if PROJECT_ROOT is not set or equals DATA_DIR.
    """
    project_root = os.path.expanduser(PROJECT_ROOT)
    nfs_root = os.path.expanduser(NFS_ROOT) if NFS_ROOT else ""
    project_dir = os.path.join(project_root, project_name)

    if os.path.exists(project_dir):
        print(f"⚠️  Project directory already exists: {project_dir}", file=sys.stderr)
        return {"local": project_dir, "nfs": None}

    # Local dirs (fast storage)
    local_dirs = ["repo", "workspace", "docs"]
    try:
        os.makedirs(project_dir, exist_ok=True)
        for d in local_dirs:
            os.makedirs(os.path.join(project_dir, d), exist_ok=True)
    except OSError as e:
        print(f"❌ Failed to create project directory: {e}", file=sys.stderr)
        return None

    # NFS shared dirs + symlink
    nfs_dir = None
    if nfs_root:
        nfs_dir = os.path.join(nfs_root, project_name)
        nfs_subdirs = ["files", "data", "archives"]
        try:
            os.makedirs(nfs_dir, exist_ok=True)
            for d in nfs_subdirs:
                os.makedirs(os.path.join(nfs_dir, d), exist_ok=True)
            # Symlink shared/ → NFS
            shared_link = os.path.join(project_dir, "shared")
            os.symlink(nfs_dir, shared_link)
        except OSError as e:
            print(f"⚠️  NFS shared dir failed (project still created locally): {e}", file=sys.stderr)
            nfs_dir = None

    # Create .project.yaml
    nfs_section = f"\nnfs_path: {nfs_dir}\n" if nfs_dir else ""
    project_yaml = f"""# Project: {project_name}
# Created: {datetime.now().isoformat()}

name: {project_name}
local_path: {project_dir}{nfs_section}
structure:
  # Local (fast storage)
  repo: "Git repository clone"
  workspace: "Agent working directory"
  docs: "Notes, reports, research"
  # Shared (NFS, via shared/ symlink)
  shared/files: "Documents, media, bulk attachments"
  shared/data: "Datasets, backups, large files"
  shared/archives: "Old versions, historical exports"
"""
    try:
        with open(os.path.join(project_dir, ".project.yaml"), "w") as f:
            f.write(project_yaml)
    except OSError as e:
        print(f"⚠️  Failed to write .project.yaml: {e}", file=sys.stderr)

    print(f"✅ Created project skeleton: {project_dir}", file=sys.stderr)
    print(f"   📁 repo/        (local)", file=sys.stderr)
    print(f"   📁 workspace/   (local)", file=sys.stderr)
    print(f"   📁 docs/        (local)", file=sys.stderr)
    if nfs_dir:
        print(f"   📁 shared/ → {nfs_dir}", file=sys.stderr)
        print(f"      📁 files/", file=sys.stderr)
        print(f"      📁 data/", file=sys.stderr)
        print(f"      📁 archives/", file=sys.stderr)
    print(f"   📄 .project.yaml", file=sys.stderr)

    return {"local": project_dir, "nfs": nfs_dir}


def create_nfs_skeleton(project_name):
    """Legacy wrapper — redirects to create_project_skeleton."""
    result = create_project_skeleton(project_name)
    if result:
        return result.get("local")
    return None

def create_tracker_doc(project_name, tag, phases, master_task_id, phase_task_ids):
    """Create a tracker document in the project's files directory."""
    project_dir = os.path.join(DATA_DIR, project_name, "files")
    
    if not os.path.exists(project_dir):
        os.makedirs(project_dir, exist_ok=True)
    
    tracker_path = os.path.join(project_dir, f"{tag.upper()}-TRACKER.md")
    
    # Build phase table
    phase_rows = []
    for i, (phase_name, task_id) in enumerate(zip(phases, phase_task_ids)):
        phase_rows.append(f"| Phase {i+1} | `{task_id[:8]}` | ⬜ Todo | {phase_name} |")
    
    tracker_content = f"""# {tag.replace('-', ' ').title()} - Tracker

**Status:** 🟡 In Progress  
**Started:** {datetime.now().strftime('%Y-%m-%d')}  
**Master Task:** `{master_task_id[:8]}`

---

## Quick Links

| Resource | Link |
|----------|------|
| Master Task | `{master_task_id}` |
| This Tracker | `{tracker_path}` |
| NFS Project Root | `/data/projects/{project_name}/` |

---

## Phase Overview

| Phase | Task ID | Status | Notes |
|-------|---------|--------|-------|
{chr(10).join(phase_rows)}

---

## Phase Details & Handoff Notes

"""
    
    # Add placeholder sections for each phase
    for i, phase_name in enumerate(phases):
        tracker_content += f"""### Phase {i+1}: {phase_name} (`{phase_task_ids[i][:8]}`)

**Goal:** (To be filled)

**Key Files:**
- (To be filled)

**Completion Criteria:**
- [ ] (To be filled)

**Notes for Next Phase:**
- (To be filled by agent)

---

"""
    
    tracker_content += f"""## Change Log

| Date | Phase | Change | Author |
|------|-------|--------|--------|
| {datetime.now().strftime('%Y-%m-%d')} | Setup | Created tracker document | CLI |

---

## Agent Instructions

**When working on any phase:**

1. **Read this tracker first** - Understand context from previous phases
2. **Update "Notes for Next Phase"** - Document important findings
3. **Update Change Log** - Record what you changed
4. **Mark subtasks correctly** - Use `complete-subtask` (review), not completed
5. **Document blockers** - Add to "Blocked Items" section

---

*Last Updated: {datetime.now().strftime('%Y-%m-%d')} by CLI*
"""
    
    with open(tracker_path, "w") as f:
        f.write(tracker_content)
    
    print(f"✅ Created tracker: {tracker_path}", file=sys.stderr)
    return tracker_path

