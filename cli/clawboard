    path = f"/projects/{project_id}/context?{qs}" if qs else f"/projects/{project_id}/context"
    result = api("GET", path)
    
    context = result.get("context", {})
    
    # Format context nicely
    print(f"─── Project Context ({args.role or 'agent'}) ───")
    
    if isinstance(context, dict):
        # Structured context
        if context.get("project"):
            p = context["project"]
            print(f"\n📁 Project: {p.get('name', 'Unknown')}")
            if p.get("description"):
                print(f"   {p['description']}")
        
        if context.get("resources"):
            r = context["resources"]
            print("\n📦 Resources:")
            if r.get("repository"):
                print(f"   Repository: {r['repository']}")
            if r.get("additionalRepos"):
                for repo in r["additionalRepos"]:
                    print(f"   Additional Repo: {repo}")
            if r.get("environments"):
                for env, url in r["environments"].items():
                    if url:
                        print(f"   {env.title()}: {url}")
            if r.get("localPaths"):
                for path_key, path_val in r["localPaths"].items():
                    if path_val:
                        print(f"   {path_key}: {path_val}")
            if r.get("links"):
                print("\n🔗 Links:")
                for link in r["links"]:
                    link_type = link.get("type", "url")
                    link_title = link.get("title", "Untitled")
                    link_url = link.get("url", "")
                    print(f"   [{link_type}] {link_title}: {link_url}")
        
        if context.get("notebooks"):
            nbs = context["notebooks"]
            print("\n📓 Notebooks:")
            if isinstance(nbs, dict):
                for ntype in ["documentation", "research"]:
                    nb = nbs.get(ntype)
                    if nb:
                        print(f"   [{ntype}] {nb.get('description', 'No description')}")
                        if nb.get("queryTips"):
                            for tip in nb["queryTips"][:2]:
                                print(f"      💡 {tip}")
                if nbs.get("additional"):
                    for nb in nbs["additional"]:
                        print(f"   [{nb.get('name', 'notebook')}] {nb.get('description', 'No description')}")
            elif isinstance(nbs, list):
                for nb in nbs:
                    print(f"   [{nb.get('type', 'unknown')}] {nb.get('description', 'No description')}")
                    if nb.get("queryTips"):
                        for tip in nb["queryTips"][:2]:
                            print(f"      💡 {tip}")
        
        if context.get("toolInstructions"):
            ti = context["toolInstructions"]
            print("\n🔧 Tool Instructions:")
            if isinstance(ti, dict):
                # Handle DB-backed tools array
                if ti.get("tools"):
                    for tool in ti["tools"]:
                        name = tool.get("name", "unknown")
                        cat = tool.get("category", "")
                        desc = tool.get("description", "")
                        badge = " 🌐" if tool.get("is_global") else ""
                        print(f"   {name}{badge} ({cat}): {desc[:80]}")
                # Handle legacy string instructions
                for key, val in ti.items():
                    if key == "tools":
                        continue
                    if isinstance(val, str):
                        lines = val.strip().split("\n")
                        print(f"   {key}:")
                        for line in lines[:3]:
                            print(f"      {line}")
                        if len(lines) > 3:
                            print(f"      ... ({len(lines) - 3} more lines)")
        
        if context.get("files"):
            files = context["files"]
            if files.get("sourceTree"):
                print(f"\n📂 Source Tree: ({len(files['sourceTree'])} entries)")
                for f in files["sourceTree"][:10]:
                    print(f"   {f}")
                if len(files["sourceTree"]) > 10:
                    print(f"   ... and {len(files['sourceTree']) - 10} more")
            if files.get("projectFiles"):
                pf = files["projectFiles"]
                print(f"\n📁 Project Files: ({len(pf)} entries)")
                for f in pf[:10]:
                    print(f"   {f}")
                if len(pf) > 10:
                    print(f"   ... and {len(pf) - 10} more")
            if files.get("readmeContent"):
                readme_lines = files["readmeContent"].split("\n")
                print(f"\n📖 README.md ({len(readme_lines)} lines):")
                for line in readme_lines[:5]:
                    print(f"   {line}")
                if len(readme_lines) > 5:
                    print(f"   ... ({len(readme_lines) - 5} more lines)")
        
        # Orchestrator-specific sections
        if context.get("tasks"):
            t = context["tasks"]
            print(f"\n📊 Tasks: {t.get('total', 0)} total")
            if t.get("byStatus"):
                for status, count in t["byStatus"].items():
                    print(f"   {status}: {count}")
    else:
        # Legacy string context
        print(context)
    
    print("────────────────────────")

