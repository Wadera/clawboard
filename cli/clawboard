#!/usr/bin/env python3
"""clawboard - CLI for ClawBoard task management.

Usage:
  clawboard list [--status STATUS] [--project PROJECT] [--priority PRIORITY] [-v]
  clawboard next
  clawboard current
  clawboard get ID
  clawboard create TITLE [options]
  clawboard update ID [options]
  clawboard move ID STATUS [--notes NOTES]
  clawboard archive ID [--reason TEXT]           # Any status; non-completed archives as abandoned (warns)
  clawboard delete ID
  clawboard spawn ID [--run] [--dry-run] [--model MODEL] [--harness openclaw|hermes] [--attach FILE ...] [--no-attach] [--interactive|--fire-and-forget]
  clawboard steer ID MESSAGE                     # Send steering message to ACP session
  clawboard cancel ID                            # Cancel (kill) linked ACP session
  clawboard session-status ID [--live]           # Show ACP session status
  clawboard breakdown ID
  clawboard auto-archive
  clawboard doctor [--json] [--discord-summary] [--deliver stdout|hermes-discord] [--deliver-target TARGET] [--post-discord] [--discord-webhook URL] [--install-cron] [--dry-run]

  # Subtask management (6-state: empty → in_progress → review → completed)
  clawboard start-subtask TASK_ID INDEX          # Agent: marks in_progress
  clawboard complete-subtask TASK_ID INDEX       # Agent: marks review (ready for approval)
  clawboard approve-subtask TASK_ID INDEX        # Orchestrator: marks completed
  clawboard reject-subtask TASK_ID INDEX --note  # Orchestrator: back to empty
  clawboard block-subtask TASK_ID INDEX --reason # Orchestrator: marks blocked
  clawboard skip-subtask TASK_ID INDEX           # Orchestrator: marks skipped (counts as done)
  clawboard uncomplete-subtask TASK_ID INDEX     # Legacy: marks as empty

  # Task dependencies
  clawboard add-dep TASK_ID DEPENDS_ON_ID        # Add dependency (task depends on another)
  clawboard remove-dep TASK_ID DEPENDS_ON_ID     # Remove dependency
  clawboard deps TASK_ID                         # Show dependencies for a task

  # Project management
  clawboard projects [--include-stats]
  clawboard project get ID
  clawboard project create --name NAME [--description DESC] [--status STATUS] [--init|--nfs]
  clawboard project update ID [--name] [--description] [--status] [--source-dir] [--nfs-dir]
  clawboard project delete ID
  clawboard project stats ID [--days DAYS]
  clawboard project context ID [--role ROLE] [--task-id TASK_ID]

  # Project resources (Project Resources)
  clawboard project set-repo ID --url URL
  clawboard project set-env ID --prod URL [--dev URL] [--staging URL]
  clawboard project set-paths ID --nfs PATH [--ssd PATH] [--docker PATH]
  clawboard project add-notebook ID --type TYPE --id NBID --url URL [--desc DESC] [--query-tips TIPS]

  # Project links
  clawboard project add-link ID --type TYPE --title TITLE --url URL [--category CAT]
  clawboard project update-link PROJECT_ID LINK_ID [--type] [--title] [--url]
  clawboard project delete-link PROJECT_ID LINK_ID

  # Tools management
  clawboard tools list [--category CAT] [--tag TAG] [--search QUERY] [--project PROJECT] [-v]
  clawboard tools add --name NAME [--category CAT] [--description DESC] [--usage TEXT] [--usage-file FILE] [--tags TAGS] [--global]
  clawboard tools update TOOL [--name] [--category] [--description] [--usage] [--tags] [--global/--no-global]
  clawboard tools delete TOOL [--confirm]
  clawboard tools link PROJECT TOOL [--override TEXT] [--override-file FILE]
  clawboard tools unlink PROJECT TOOL
  clawboard tools context PROJECT

  # Multi-phase job creation
  clawboard create-multiphase "TITLE" --project PROJECT --tag TAG --phases "Phase 1;Phase 2;..."

  clawboard help

Examples:
  # Task creation (auto-pickup defaults to OFF; opt in with --auto-start true)
  clawboard create "Fix login bug" --project my-project --priority high --subtasks "Check auth;Fix token;Test"
  clawboard create "Research topic" --project my-project --status ideas --tags "research,agent-task"
  clawboard create "Nightly maintenance" --project ops --status todo --auto-start true   # orchestrator may auto-pick this

  # Task management
  clawboard list --status todo
  clawboard move abc123 in-progress --notes "Starting work"
  clawboard update abc123 --priority urgent --add-subtask "New subtask"

  # Subtask workflow (tri-state)
  clawboard complete-subtask abc123 0       # Agent marks as review
  clawboard approve-subtask abc123 0        # Orchestrator approves → completed
  clawboard reject-subtask abc123 0 --note "Needs more testing"

  # Agent spawning (ACP interactive by default)
  clawboard spawn abc123                       # Print prompt / spawn agent
  clawboard spawn abc123 --run                 # Full auto: move to in-progress + spawn interactive ACP session
  clawboard spawn abc123 --run --dry-run       # Preview what --run would spawn (prompt + context)
  clawboard spawn abc123 --run --model openai-codex/gpt-5.5  # Override model
  clawboard spawn abc123 --run --attach /path/to/audit.md --attach /path/to/config.json  # Attach files
  clawboard spawn abc123 --run --no-attach     # Disable auto-attachment of project context files

  # Optional legacy mode (explicit only)
  clawboard spawn abc123 --run --fire-and-forget  # Spawn old cron-style isolated run
  clawboard spawn abc123 --run --harness hermes   # Spawn on the Hermes harness

  # Interactive spawning (ACP-based, steer mid-flight)
  clawboard spawn abc123 --run --interactive   # Explicit interactive spawn (same as default)
  clawboard steer abc123 "Focus on the auth module first"  # Send steering message
  clawboard cancel abc123                      # Kill the ACP session
  clawboard session-status abc123              # Show session state

  # Project creation with NFS skeleton
  clawboard project create --name "my-project" --description "My new project" --nfs

  # Project resources
  clawboard project set-repo my-proj --url "https://github.com/example/my-project"
  clawboard project set-env my-proj --prod "https://example.com/dashboard/" --dev "https://dev.example.com/dashboard/"
  clawboard project set-paths my-proj --nfs "/data/projects/my-project" --ssd "/opt/clawboard/projects/my-project"
  clawboard project add-notebook my-proj --type documentation --id "abc123" --url "https://notebooklm.google.com/..." --query-tips "Ask about API structure"
  clawboard project context my-proj --role agent --task-id abc123

  # Multi-phase job
  clawboard create-multiphase "Website Redesign" --project my-site --tag "site-redesign" --phases "Design;Frontend;Backend;Testing"

Complete Workflows:

  # Orchestrator: Spawn and verify a task
  clawboard next                                  # Get next task
  clawboard spawn abc123 --run                    # Move to in-progress + spawn agent in one shot
  # --- OR manual two-step: ---
  clawboard move abc123 in-progress               # Start it manually
  clawboard spawn abc123                          # Get agent prompt / spawn
  # ... spawn agent ...
  clawboard get abc123 -v                         # Check progress
  clawboard approve-subtask abc123 0              # Approve each subtask
  clawboard approve-subtask abc123 1
  clawboard move abc123 completed                 # Mark done

  # Agent: Work a task
  clawboard get abc123 -v                         # Read task
  # ... do work on subtask 0 ...
  clawboard complete-subtask abc123 0             # Mark review
  # ... do work on subtask 1 ...
  clawboard complete-subtask abc123 1             # Mark review
  clawboard move abc123 stuck --notes "Ready"     # Signal done

  # Setup new project
  clawboard project create --name "my-proj" --nfs
  clawboard project set-repo my-proj --url "git@..."
  clawboard project set-env my-proj --prod "https://..." --dev "https://..."
  clawboard project set-paths my-proj --nfs "/data/projects/my-proj"
"""

