def cmd_report_update(args):
    """Update a report."""
    report_id = resolve_report_id(args.id)
    data = {}

    if args.title:
        data["title"] = args.title
    if args.content:
        data["content"] = args.content
    if args.file:
        try:
            with open(args.file, "r") as f:
                data["content"] = f.read()
        except FileNotFoundError:
            print(f"❌ File not found: {args.file}", file=sys.stderr)
            sys.exit(1)
    if args.tags:
        data["tags"] = [t.strip() for t in args.tags.split(",") if t.strip()]
    if args.summary:
        data["summary"] = args.summary
    if args.pinned:
        if is_automation_context():
            print("ℹ️  Ignoring --pinned: pinning reports is a human/on-demand action, not an agent default.", file=sys.stderr)
        else:
            data["pinned"] = True
    if args.unpinned:
        data["pinned"] = False

    # Handle task additions/removals
    if args.add_task or args.remove_task:
        # Fetch current report to get existing task_ids
        current = api("GET", f"/reports/{report_id}")
        report = current.get("report", current)
        existing_tasks = report.get("task_ids", [])

        if args.add_task:
            new_id = resolve_task_id(args.add_task)
            if new_id not in existing_tasks:
                existing_tasks.append(new_id)
        if args.remove_task:
            rm_id = resolve_task_id(args.remove_task)
            existing_tasks = [t for t in existing_tasks if t != rm_id]

        data["task_ids"] = existing_tasks

    if not data:
        print("❌ No update fields specified", file=sys.stderr)
        sys.exit(1)

    result = api("PATCH", f"/reports/{report_id}", data)
    report = result.get("report", result)

    print(f"✅ Updated report: {report.get('title', report_id[:8])}")


